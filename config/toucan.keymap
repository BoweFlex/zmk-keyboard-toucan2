#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define MOU  4
#define GAME  5

// Home row mod positional guards (bilateral combinations only)
// Left-hand mods only trigger with right-hand keys + left thumbs
#define LEFT_HRM_TRIGGERS  6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 36 37 38
// Right-hand mods only trigger with left-hand keys + right thumbs
#define RIGHT_HRM_TRIGGERS 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 39 40 41

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HRM_TRIGGERS>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HRM_TRIGGERS>;
            hold-trigger-on-release;
            display-name = "Home Row Mod Right";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp ESC   &kp Q &kp W          &kp E          &kp R           &kp T   &kp Y &kp U           &kp I           &kp O           &kp P    &trans
                &kp COLON &kp A &hml LCTRL S   &hml LALT D    &hml LGUI F     &kp G   &kp H &hmr RGUI J     &hmr RALT K     &hmr RCTRL L    &kp SQT  &kp SEMI
                &trans    &kp Z &kp X          &kp C          &kp V           &kp B   &kp N &kp M           &kp COMMA       &kp DOT         &kp FSLH &trans
                                &kp DEL        &lt SYM BSPC   &kp LSHFT       &kp RET &lt NAV SPACE  &trans
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans &kp N1 &kp N2 &kp N3 &kp N4  &kp N5    &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &to GAME
                &trans &kp N4 &kp N5 &kp N6 &trans  &kp ESC   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &trans &kp N7 &kp N8 &kp N9 &kp N0  &kp TAB   &kp TAB  &trans   &trans &trans    &trans &trans
                                 &kp LGUI  &trans  &kp LALT   &trans   &trans   &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans &trans   &trans   &kp LBRC &kp LBKT &kp LPAR   &kp RPAR &kp RBKT &kp RBRC &trans   &trans   &to GAME
                &trans &trans &kp AT  &kp TILDE &kp BSLH &kp PLUS  &kp EQUAL &kp PIPE &kp GRAVE &kp EXCL &trans &trans
                &trans &trans   &kp AMPS &kp PRCNT &kp HASH &kp UNDER &kp MINUS &kp DLLR &kp CARET &kp ASTRK &trans  &trans
                                          &trans  &trans &trans   &trans  &trans   &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F10 &kp C_PP      &kp PSCRN    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR
                &kp F4 &kp F5 &kp F6 &kp F11 &kp C_VOL_UP  &kp C_BRI_UP &kp C_MUTE   &trans       &trans       &trans       &trans       &trans
                &kp F7 &kp F8 &kp F9 &kp F12 &kp C_VOL_DN  &kp C_BRI_DN &trans       &trans       &trans       &trans       &trans       &trans
                              &trans &trans &trans   &trans &trans &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp MCLK &mkp LCLK &mkp RCLK
            >;
        };

        game {
            display-name = "GAME";
            bindings = <
                &kp ESC   &kp Q &kp W          &kp E          &kp R           &kp T   &kp Y &kp U           &kp I           &kp O           &kp P    &to BASE
                &kp TAB   &kp A &kp S          &kp D          &kp F           &kp G   &kp H &kp J           &kp K           &kp L           &kp SQT  &kp SEMI
                &kp LALT  &kp Z &kp X          &kp C          &kp V           &kp B   &kp N &kp M           &kp COMMA       &kp DOT         &kp FSLH &trans
                                &kp LCTRL      &kp SPACE      &kp LSHFT       &kp RET &kp BSPC  &to BASE
            >;
        };

        extra_3 {
                status = "reserved";
        };
    };
};
